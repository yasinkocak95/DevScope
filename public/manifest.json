{
  "manifest_version": 3,
  "name": "DevScope",
  "version": "2.0.0",
  "description": "Inspect API traffic and create useful, privacy-conscious bug reports.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/devscope-icon-16.png",
    "32": "icons/devscope-icon-32.png",
    "48": "icons/devscope-icon-48.png",
    "128": "icons/devscope-icon-128.png"
  },
  "action": {
    "default_title": "Open DevScope",
    "default_icon": {
      "16": "icons/devscope-icon-16.png",
      "32": "icons/devscope-icon-32.png",
      "48": "icons/devscope-icon-48.png",
      "128": "icons/devscope-icon-128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "permissions": [
    "activeTab",
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/pageHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/relay.js", "assets/floatingLoader.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
